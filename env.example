# -------------------------------------------------------------------
# Geo Services API — Environment Variables
# -------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# -------------------------------------------------------------------

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=geo_services
DB_USER=postgres
DB_PASSWORD=your_password_here

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# -------------------------------------------------------------------
# Frontend configuration — set once at deployment, never per request.
#
# FRONTEND_LIBRARY:      Mapping library the frontend uses.
#                        Supported: leaflet, mapboxgl, googlemaps, arcgis, openlayers
#
# FRONTEND_VERSION:      Library version. Used for forward compatibility.
#
# FRONTEND_CAPABILITIES: Comma-separated list of agent command types
#                        that the frontend has implemented.
#                        The agent only sends commands in this list.
#                        Available commands:
#                          zoom_to, add_layer, remove_layer,
#                          highlight_boundary, show_stat, show_chart, clear_map
# -------------------------------------------------------------------
FRONTEND_LIBRARY=leaflet
FRONTEND_VERSION=1.9
FRONTEND_CAPABILITIES=zoom_to,add_layer,remove_layer,highlight_boundary,show_stat,show_chart,clear_map
