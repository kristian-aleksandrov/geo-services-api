# =============================================================================
# Geo Services API — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Environment — never commit credentials
# -----------------------------------------------------------------------------
.env
.envrc

# -----------------------------------------------------------------------------
# Data files — too large for git
# All source data lives in data/ and is downloaded by scripts/load_data.py
# -----------------------------------------------------------------------------
data/
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.fbn
*.fbx
*.ain
*.aih
*.atx
*.ixs
*.mxs
*.zip

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg-info/
*.egg
MANIFEST
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# Virtual environments
venv/
.venv/
env/
env.bak/
venv.bak/
ENV/
__pypackages__/

# Testing
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

